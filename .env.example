# Copy to .env or set these in PowerShell before starting Spring Boot.
# These are the same connection details you use in pgAdmin.
DATABASE_URL=jdbc:postgresql://localhost:5432/pingprint
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-your-postgres-password

# Must be a long random value in real environments.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MINUTES=60
FRONTEND_URL=http://localhost:5173
PORT=8080
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Leave these as-is for now. Signup verification tokens are logged until SMTP is configured.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# Backend-only payment credentials.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Backend-only Epson Connect API v2 application credentials.
EPSON_API_KEY=replace_me
EPSON_CLIENT_ID=replace_me
EPSON_CLIENT_SECRET=replace_me
EPSON_REDIRECT_URI=http://localhost:8080/api/epson/oauth/callback

# Generate with:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Keep this stable. Changing it prevents existing Epson tokens from being decrypted.
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
